+void PortalRequest::subscribe(const QString &token)
+{
+    QString sender = QDBusConnection::sessionBus().baseService().mid(1);
+    sender.replace(u'.', u'_');
+    m_path = QStringLiteral("/org/freedesktop/portal/desktop/request/%1/%2").arg(sender, token);
+    QDBusConnection::sessionBus().connect(dbusService, m_path, dbusRequestInterface, dbusResponse, this, SLOT(onFinished(uint, QVariantMap)));
+}
