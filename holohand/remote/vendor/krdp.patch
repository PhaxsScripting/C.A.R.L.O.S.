+            QDBusConnection::sessionBus().disconnect(dbusService, m_path, dbusRequestInterface, dbusResponse, this, SLOT(onFinished(uint, QVariantMap)));
+            m_path = reply.value().path();
+            QDBusConnection::sessionBus().connect(dbusService, m_path, dbusRequestInterface, dbusResponse, this, SLOT(onFinished(uint, QVariantMap)));
+        }
     } else {
-        m_callback(-1, {{QStringLiteral("errorMessage"), reply.error().message()}});
